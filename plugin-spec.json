  "versionCode": 11,
  "entryClass": "com.kigtts.tools.store.PackageStorePlugin",
  "apiVersion": 16,
  "minSdk": 26,
  "runtime": "android-dex",
  "license": "MIT",
  "icon": { "symbol": "storefront" },
